PORT=5000

# MySQL Database Connection (via XAMPP)
DATABASE_URL="mysql://root:@localhost:3306/reachinbox"

# Redis Connection (via Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch Connection (via Docker)
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth Setup
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# JWT and Session Secrets
JWT_SECRET=your-jwt-secret-key-at-least-32-characters
SESSION_SECRET=your-session-secret-key

# Ethereal Email SMTP Setup (Create at https://ethereal.email/)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your-ethereal-user
ETHEREAL_PASSWORD=your-ethereal-password

# Slack OAuth Setup
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Worker Configuration
WORKER_CONCURRENCY=5
DEFAULT_EMAIL_DELAY_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=200

# Frontend URL
FRONTEND_URL=http://localhost:5173
